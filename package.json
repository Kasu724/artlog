{
  "name": "artlog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:desktop": "npm run notices && npm run dev",
    "build": "tsc -b && vite build",
    "build:desktop": "npm run build && npm run notices",
    "notices": "node scripts/third-party-notices.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "format": "prettier --write \"*.{json,ts,tsx,js,mjs,html}\" \"src/**/*.{ts,tsx,css}\" \"src-tauri/**/*.json\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"*.{json,ts,tsx,js,mjs,html}\" \"src/**/*.{ts,tsx,css}\" \"src-tauri/**/*.json\" \"scripts/**/*.mjs\"",
    "check": "npm run format:check && npm run lint && npm test -- --run && npm run build",
    "test": "vitest",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^15.0.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.0.0",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
